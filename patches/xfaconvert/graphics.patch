+// xfaconvert: Adobe Acrobat draws XFA lines and boxes without anti-aliasing.
+// PDFIUM_XFA_PATH_ALIASED=1 turns path anti-aliasing off;
+// PDFIUM_XFA_STROKE_ADJUST=1 snaps stroke widths to the device pixel grid.
+bool XfaEnvFlag(const char* name) {
+  const char* value = getenv(name);
+  return value && value[0] && value[0] != '0';
+}
+
+CFX_FillRenderOptions XfaPathOptions(CFX_FillRenderOptions options) {
+  if (XfaEnvFlag("PDFIUM_XFA_PATH_ALIASED")) {
+    options.aliased_path = true;
+  }
+  if (XfaEnvFlag("PDFIUM_XFA_STROKE_ADJUST")) {
+    options.adjust_stroke = true;
+  }
+  return options;
+}
+
+}  // namespace
 
