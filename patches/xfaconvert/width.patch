+std::optional<float> CFGAS_GEFont::GetCharWidthExact(wchar_t wUnicode) {
+  auto it = char_width_exact_map_.find(wUnicode);
+  if (it != char_width_exact_map_.end()) {
+    return it->second;
+  }
+
+  auto [glyph, pFont] = GetGlyphIndexAndFont(wUnicode, true);
+  if (!pFont || glyph == 0xffff) {
+    char_width_exact_map_[wUnicode] = std::nullopt;
+    return std::nullopt;
+  }
+  if (pFont != this) {
+    return pFont->GetCharWidthExact(wUnicode);
+  }
+
+  // Substituted generic fonts adjust widths to the requested font; keep the
+  // regular (rounded) path for those.
+  std::optional<float> width;
+  RetainPtr<CFX_Face> face = font_->GetFace();
+  const CFX_SubstFont* subst = font_->GetSubstFont();
+  if (face && !(subst && subst->IsBuiltInGenericFont())) {
+    float exact = face->GetGlyphWidthExact(glyph);
+    if (exact >= 0) {
+      width = exact;
+    }
+  }
+  if (!width.has_value()) {
+    std::optional<uint16_t> rounded = GetCharWidth(wUnicode);
+    if (rounded.has_value()) {
+      width = static_cast<float>(rounded.value());
+    }
+  }
+  char_width_exact_map_[wUnicode] = width;
+  return width;
+}
