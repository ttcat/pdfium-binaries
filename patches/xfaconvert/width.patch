+float CFX_Face::GetGlyphWidthExact(uint32_t glyph_index) {
+  FT_FaceRec* rec = GetRec();
+  const uint16_t units_per_em = GetUnitsPerEm();
+  if (!rec || units_per_em == 0) {
+    return -1.0f;
+  }
+  int err = FT_Load_Glyph(
+      rec, glyph_index, FT_LOAD_NO_SCALE | FT_LOAD_IGNORE_GLOBAL_ADVANCE_WIDTH);
+  if (err) {
+    return -1.0f;
+  }
+  return static_cast<float>(rec->glyph->metrics.horiAdvance) * 1000.0f /
+         units_per_em;
+}
