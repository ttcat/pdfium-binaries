+// xfaconvert: Adobe Acrobat stretches only spaces when justifying; PDFium
+// stretched every break opportunity (after "/", "-", zero-width spaces...).
+bool IsJustifyGap(const CFGAS_Char* tc) {
+  if (tc->line_break_type_ != pdfium::LineBreakType::kDirectBreak) {
+    return false;
+  }
+  return !UseExactWidths() || tc->GetCharType() == CharType::kSpace;
+}
+
+// A run of spaces counts as one gap (only its last space stretches).
+bool IsJustifyGapAt(const CFGAS_BreakPiece& piece, int32_t j) {
+  const CFGAS_Char* tc = piece.GetChar(j);
+  if (!IsJustifyGap(tc)) {
+    return false;
+  }
+  if (!UseExactWidths() || j + 1 >= piece.GetCharCount()) {
+    return true;
+  }
+  return piece.GetChar(j + 1)->GetCharType() != CharType::kSpace;
+}
